# Copia este archivo a .env y reemplaza la clave por una credencial local.
# No uses datos reales de residentes en esta etapa.
MOMENTO_DATABASE_URL=postgresql+psycopg://momento_dev:change-me-local-only@127.0.0.1:5432/momento_dev

# Correo (invitaciones, recuperación de contraseña y avisos de incidentes).
# Ya está armado para enviar con Gmail desde illanezjorgea@gmail.com. Solo falta
# MOMENTO_SMTP_PASSWORD: una "contraseña de aplicación" de Google (no la contraseña
# de la cuenta). Se crea en https://myaccount.google.com/apppasswords con la
# verificación en dos pasos activada. Sin ella no se envía nada.
MOMENTO_MAIL_FROM=illanezjorgea@gmail.com
MOMENTO_SMTP_PASSWORD=
# Solo desarrollo en esta Mac: sin contraseña, muestra los correos en la consola de la API.
MOMENTO_MAIL_DEBUG=true
MOMENTO_PUBLIC_URL=http://127.0.0.1:5173
# Otro proveedor (opcional): por defecto smtp.gmail.com, usuario = remitente, puerto 587.
# MOMENTO_SMTP_HOST=smtp.gmail.com
# MOMENTO_SMTP_USER=illanezjorgea@gmail.com
# MOMENTO_SMTP_PORT=587
# MOMENTO_SMTP_STARTTLS=true
